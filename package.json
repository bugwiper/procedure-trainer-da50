{
  "name": "procedure-trainer-da-50",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "node scripts/validate-scenarios.mjs",
    "format": "prettier --write src tests e2e scripts",
    "format:check": "prettier --check src tests e2e scripts",
    "build:e2e": "VITE_TEST_HOOKS=1 BASE_PATH=/procedure-trainer-da-50/ vite build --outDir dist-e2e",
    "preview:e2e": "BASE_PATH=/procedure-trainer-da-50/ vite preview --outDir dist-e2e --port 4173 --strictPort",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/b612": "5.3.0",
    "@fontsource/b612-mono": "5.3.0",
    "@preact/signals": "2.11.3",
    "@toon-format/toon": "4.4.0",
    "preact": "11.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
