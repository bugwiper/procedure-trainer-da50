# ENGINE FIRE in flight (format 1). The checklist is reproduced as printed in the DA50 C / RG Emergency Procedures checklist, Edition 4.1 of 2022-10-05 (owner decision 2026-10-23): every checklist line is as printed except the squawk 7700 row, which is the one row that is not printed (an own addition, optional); all other text is own wording. The fire constants, the outcome threshold and hold time, the onset window and the forbidden items are instructor-review values.
format: 1
id: eng-fire-in-flight
title: ENGINE FIRE
source:
  document: "DA50 C / RG Emergency Procedures checklist"
  issue: "Edition 4.1, 2022-10-05"
  section: AFM 03-33 ENGINE FIRE IN FLIGHT
  verified: "2026-10-23"
disclaimer: training-aid
scene: cruise
briefing:
  situation: "You are in cruise flight when you see smoke and flames coming from the engine compartment. No message is shown on the primary flight display. The engine temperatures are rising and the fire is growing."
initial:
  controls:
    lv.env_circ: recirc
  quantities:
    fire_intensity: 40
    oil_temp_c: 103
    coolant_temp_c: 97
    gearbox_temp_c: 91
parameters:
  engine_fire: 1
annunciations[0]:
checklist:
  form: table
  heading: ENGINE FIRE IN FLIGHT
procedure[14]:
  - kind: group
    id: grp_circ_air
    ordered: false
    steps[1]:
      - id: circ_air_fresh
        severity: critical
        number: 1
        text: ECS circulating air
        action: FRESH AIR
        done:
          check: state
          control: lv.env_circ
          is: fresh
  - kind: group
    id: grp_ecs_pull
    ordered: false
    steps[1]:
      - id: ecs_pulled
        severity: critical
        number: 2
        text: ECS shut-off
        action: PULL
        done:
          check: state
          control: lv.ecs_shutoff
          is: pulled
  - kind: comment
    text: Select appropriate emergency landing area
  - kind: group
    id: grp_eng_master
    ordered: false
    steps[1]:
      - id: engine_master_off
        severity: critical
        number: 3
        text: Engine master
        action: "OFF"
        done:
          check: state
          control: sw.engine_master
          is: off
  - kind: group
    id: grp_fuel_valve
    ordered: false
    steps[1]:
      - id: fuel_valve_off
        severity: critical
        number: 4
        text: Fuel valve
        action: "OFF"
        done:
          check: state
          control: sw.fuel_valve
          is: off
  - kind: group
    id: grp_elect_master
    ordered: false
    steps[1]:
      - id: elect_master_off
        severity: critical
        number: 5
        text: Electric master
        action: "OFF"
        done:
          check: state
          control: sw.elect_master
          is: off
  - kind: line
    number: 6
    text: Airspeed
    action: "AS REQUIRED / CONSIDER HIGHER"
  - kind: line
    number: 7
    text: Emergency front windows
    action: OPEN as necessary
  - kind: comment
    text: "Carry Out:"
  - kind: comment
    text: EMERGENCY LANDING (ENGINE OFF)
    boxed: true
    action: (page 9)
  - kind: comment
    text: "After standstill and when engine stopped:"
  - kind: line
    number: 8
    text: Doors
    action: OPEN
  - kind: comment
    text: Evacuate
  - kind: group
    id: grp_xpdr_code
    ordered: false
    steps[1]:
      - id: squawk_7700
        severity: optional
        text: "Transponder: squawk 7700"
        done:
          check: state
          control: kp.squawk
          is: "7700"
# The emergency fuel pump would feed the fire and fails the run; more power is reported only. Both are instructor-review items.
forbidden[2]:
  - id: emerg_fuel_pump_on
    text: Switch on the emergency fuel pump
    fails_run: true
    trigger:
      check: state
      control: sw.emerg_fuel_pump
      is: on
  - id: power_increased
    text: Increase power
    fails_run: false
    trigger:
      check: travel_rel
      control: lv.power
      op: gt
      delta: 0
# The outcome ends the run as a fail when the fire stays at a high intensity; the intensity and the hold time are instructor-review values.
outcomes[1]:
  - id: fire_spreads
    text: Fire spreads beyond the engine compartment
    hold_s: 20
    when:
      check: quantity
      quantity: fire_intensity
      op: gte
      value: 85
# The fire of the level Realistic begins at a random second inside this short window; the window is an instructor-review value.
onset:
  window_s[2]: 2,6
