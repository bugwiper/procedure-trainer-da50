# ENG OIL TEMP with oil pressure in the green range (format 1 blueprint). The checklist (heading, message, lines, labels and markers) is reproduced as printed in the DA50 C / RG Emergency Procedures checklist, Edition 4.1 of 2022-10-05 (owner decision 2026-10-23); all other text is own wording. The four lines of the oil pressure too low branch are shown only and are not graded (D-08). The oil cooling is degraded under parameters; the oil temperature model itself is aircraft data.
format: 1
id: eng-oil-temp-green
title: ENG OIL TEMP
source:
  document: "DA50 C / RG Emergency Procedures checklist"
  issue: "Edition 4.1, 2022-10-05"
  section: AFM 03-08 ENG OIL TEMP
  verified: "2026-10-23"
disclaimer: training-aid
scene: cruise
briefing:
  situation: "You are in cruise flight when the red ENG OIL TEMP message appears on the primary flight display. The oil temperature reading is high. The oil pressure is indicated in the green range and the engine otherwise runs smoothly."
initial:
  controls:
    lv.power: p75
    lv.cowl_flap: closed
  quantities:
    oil_temp_c: 128
    oil_pressure_bar: 5
parameters:
  oil_cooling: 0.55
annunciations[1]: eng_oil_temp
checklist:
  form: outline
  heading: ENG OIL TEMP
  message: OIL TEMPERATURE HIGH
procedure[1]:
  - kind: decision
    marker: arrow
    text: Check oil pressure
    branches[2]:
      - marker: diamond_arrow
        label: "If too low:"
        when:
          check: band
          quantity: oil_pressure_bar
          in[2]: low_red,low_yellow
        nodes[4]:
          - kind: line
            marker: double_arrow
            text: Reduce power
          - kind: line
            marker: double_arrow
            text: Open cowl flap
          - kind: line
            marker: double_arrow
            text: Be prepared for loss of oil and engine failure
          - kind: line
            text: Be prepared for emergency landing
      - marker: diamond
        label: "If in green range:"
        when:
          check: band
          quantity: oil_pressure_bar
          in[1]: green
        nodes[4]:
          - kind: group
            id: immediate
            ordered: false
            steps[2]:
              - id: reduce_power
                severity: critical
                marker: double_arrow
                text: Reduce power
                done:
                  check: travel_rel
                  control: lv.power
                  op: lte
                  delta: -10
              - id: open_cowl_flap
                severity: critical
                marker: double_arrow
                text: Open cowl flap
                done:
                  check: state
                  control: lv.cowl_flap
                  is: open
          - kind: line
            marker: double_arrow
            text: Increase airspeed
          - kind: line
            marker: double_arrow
            text: Check oil temp in green range
          - kind: branch
            marker: circle
            label: "If not returning to green range:"
            decided_at: run
            when:
              check: band
              quantity: oil_temp_c
              in[3]: low_yellow,high_yellow,high_red
            nodes[1]:
              - kind: line
                marker: square
                text: land at nearest suitable airfield
forbidden[1]:
  - id: power_increased
    text: Increase power
    fails_run: true
    trigger:
      check: travel_rel
      control: lv.power
      op: gt
      delta: 0
# The outcome ends the run as a fail when the oil temperature stays above the red line; the temperature and the hold time are instructor-review values.
outcomes[1]:
  - id: engine_failure
    text: Engine failure from overheating
    hold_s: 15
    when:
      check: quantity
      quantity: oil_temp_c
      op: gte
      value: 140
# The failure of the level Realistic begins at a random second inside this window, with the oil temperature just below the yellow band. The oil temperature then rises with the aircraft's own rate curve: yellow about 1 s after the onset, red with the message about 20 s after it (lint L15 allows 22 s), and the named outcome about 3 minutes after the start of red. The window, the start reading and the bound are instructor-review values.
onset:
  window_s[2]: 2,6
  # Start reading of the Realistic run: at the top of the green range.
  quantities:
    oil_temp_c: 114
  # Latest second after the onset by which the message must show in a run that does nothing.
  message_within_s: 22
